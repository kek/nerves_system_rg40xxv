BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
# Select the custom toolchain explicitly, or none of the six lines below take
# effect. Buildroot's toolchain choice is ordered so that the vendor toolchain
# for the architecture comes first and is therefore the default -- its own
# comment says "Aarch64 (use ARM toolchain by default)" and, of the custom
# entry, "Kept last, so it remains the non-default choice". Kconfig does not
# warn that CUSTOM_PREFIX, CUSTOM_GLIBC, HEADERS_* and URL only exist under
# CUSTOM; it silently resolves the choice to Arm's toolchain and ignores them.
#
# This was missing from the first commit, so every build until now used Arm GNU
# Toolchain 15.2.Rel1 with glibc 2.42 and the aarch64-none-linux-gnu prefix,
# while this file said otherwise. Nothing failed: NIFs are compiled with the
# Nerves toolchain but against this system's sysroot, because
# nerves-env-helper.sh puts --sysroot in CFLAGS and LDFLAGS, so symbol versions
# came from the image rather than from the compiler. The app's NIFs need no
# more than GLIBC_2.17. It was wrong rather than broken.
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.0/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.0-8DAF9F3.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"
# Both read off the toolchain itself rather than assumed: its gcc reports
# 15.3.0, and its sysroot's linux/version.h says LINUX_VERSION_MAJOR 6,
# PATCHLEVEL 0. Buildroot offers headers symbols up to 7_0, so declaring 6_0 is
# a floor and not a guess. BR2_TOOLCHAIN_EXTERNAL_REL_BIN_PATH is deliberately
# absent: it defaults to "bin", which is right here.
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"

# Compiler cache. This is aimed at one specific 88 minutes.
#
# Measured over run 32008727891, four packages are 68% of a 3h22m build:
#
#     linux        48.5 min   host-llvm    46.7 min
#     host-clang   41.3 min   spirv-tools   7.8 min
#
# host-* packages are 60% of the whole build and not one byte of them reaches
# the device. They are here because panfrost selects
# BR2_PACKAGE_MESA3D_NEEDS_PRECOMP_COMPILER, which pulls in host-mesa3d, whose
# HOST_MESA3D_DEPENDENCIES names host-llvm outright and host-clang through
# host-libclc. There is no way to drop them and keep the GPU -- checked in
# package/mesa3d/, not assumed -- so the only lever left is not compiling the
# same unchanged sources every time.
#
# ccache reaches them: Makefile:517 sets HOSTCC = $(CCACHE) $(HOSTCC_NOCCACHE)
# when this is on, so host packages are cached too, which is the whole point.
# Caching only target packages would have missed the 88 minutes entirely.
#
# Buildroot's warning is worth repeating: it does NOT invalidate the cache
# when the compiler changes. The external toolchain URL above is part of this
# file, and CI keys its ccache cache on a hash of this file, so a toolchain
# bump starts from an empty cache rather than a poisoned one.
BR2_CCACHE=y
# The default 5G is more than this needs and CI has a 10 GB budget shared with
# the Buildroot download cache. LLVM and clang objects compress well.
BR2_CCACHE_INITIAL_SETUP="--max-size=4G"
BR2_ENABLE_DEBUG=y
# Our patches/ is listed after the platform's so that both apply. See
# patches/linux/ for why the kernel needs one.
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches ${NERVES_DEFCONFIG_DIR}/patches"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh ${NERVES_DEFCONFIG_DIR}/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.44"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="${NERVES_DEFCONFIG_DIR}/linux/linux-6.18.defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="${NERVES_DEFCONFIG_DIR}/linux/sun50i-h700-anbernic-rg40xx-v.dts"
# The panel description, embedded in the kernel image rather than read from
# the rootfs. See linux/nerves.fragment for why the panel driver is built in,
# and patches/buildroot/0002 for why Buildroot needs a patch to allow this.
# Same directory the overlay installs to /lib/firmware, so the blob is not
# duplicated -- it is simply used twice, once linked in and once on disk.
BR2_LINUX_KERNEL_EXTRA_FIRMWARE_DIR="${NERVES_DEFCONFIG_DIR}/rootfs_overlay/lib/firmware"
# The boot logo: Tux, Erlang, Elixir and Nerves, side by side on black. One
# strip rather than one image, because fbcon draws n copies of the logo where
# n*(width+8)-8 <= xres -- so a quad-core board shows four Tuxes, but any image
# wider than 316 px on this 640-wide panel is drawn exactly once. Buildroot
# converts the PNG to logo_linux_clut224.ppm (224 colours) at kernel build
# time and enables CONFIG_LOGO itself; the conversion pulls in
# host-imagemagick. Provenance and trademark terms for all four marks are in
# REUSE.toml and docs/boot-logo.md; regenerate the strip with
# assets/bootlogo/build.sh.
BR2_LINUX_KERNEL_CUSTOM_LOGO_PATH="${NERVES_DEFCONFIG_DIR}/assets/bootlogo/bootlogo.png"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
# Adds devmem, which nerves-common's busybox.config turns off. See the header
# of the fragment for why the display work needs it.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox/busybox.fragment"
BR2_PACKAGE_F2FS_TOOLS=y
# Do NOT set BR2_TARGET_ROOTFS_SQUASHFS4_XZ here. U-Boot reads the kernel,
# the device tree, and extlinux.conf out of the squashfs itself, and its
# squashfs driver supports zlib/lzo/lz4/zstd but not xz. Buildroot defaults
# to "-comp gzip", which U-Boot's FS_SQUASHFS handles via ZLIB. Switching to
# xz to save space would produce an image that cannot be booted.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBP11=y
BR2_PACKAGE_UNIXODBC=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_DTC_PROGRAMS=y

# The soak tool for the vdd-dram question (docs/dram-verification.md). It locks
# and pattern-tests memory, which is what distinguishes a marginal DRAM rail
# from a working one -- the failure mode there is rare corruption under load and
# heat, not a hang, so it cannot be observed by using the device normally.
# ~40 KB, and worth carrying: a device with 1 GB of DRAM whose rail voltage was
# inherited from another memory type should be able to answer that on demand.
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_LIBMNL=y
# Bring-up tools. On-device verification is the unfinished half of this
# system: the button GPIO mapping and the audio routing are inherited from
# mainline's rg35xx-plus.dts on the premise that the RG40XXV is the same
# board family, and nothing here has been confirmed on hardware. evtest and
# aplay/speaker-test are how you confirm or refute that, so they ship in the
# image rather than leaving the README's checklist unfollowable.
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# libdrm's test programs, for the same reason: "no picture" covers several
# unrelated failures and none of them can be told apart by looking at the
# device. modetest enumerates connectors, CRTCs and modes and can draw a test
# pattern, which is what distinguishes "DRM never bound" from "bound but dark".
# See docs/display.md.
#
# No per-GPU option is selected: those build vendor userspace libraries
# (libdrm_intel and friends), while modetest uses the generic KMS ioctls.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y

# Cairo, for Scenic. scenic_driver_local picks its backend from MIX_TARGET:
# cairo-gtk on the host, cairo-fb under Nerves -- CPU rendering straight into
# /dev/fb0, no GPU involved. Its docs name this exact symbol, and note that
# the official Nerves systems set it by default; this system is not one of
# those, so nothing pulled it in. Without it the driver has nothing to link
# against.
#
# This is deliberately the GPU-independent path. The framebuffer here is
# 640x480 XRGB8888, 1,228,800 bytes a frame, and a full-frame write measured
# 604 fps unthrottled, so CPU-side compositing has ample headroom at this
# size. Anything wanting GLES needs the Mali to bind first -- see
# CONFIG_SUN50I_H6_PRCM_PPU in linux/nerves.fragment.
#
# freetype is not optional and Buildroot will not pull it in on cairo's
# account: the driver's Makefile runs
# `pkg-config --static --libs freetype2 cairo` for both cairo targets, so
# without it the NIF fails to link rather than degrading to no text.
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_FREETYPE=y

# Mesa, for GLES2 on the Mali-G31. The kernel side works as of
# CONFIG_SUN50I_H6_PRCM_PPU -- panfrost binds and /dev/dri/renderD128 exists --
# but a render node is not an API. Everything that wants the GPU wants EGL and
# GLES2 on top of it: Emerge's DRM/KMS backend requires "OpenGL ES 2 or newer",
# and libretro cores expect the same.
#
# REQUIRES patches/buildroot/0001-mesa3d-panfrost-without-target-llvm applied
# to the Buildroot tree, which `mix compile` does itself (see
# patches/buildroot/README.md). Without it Kconfig silently drops the panfrost
# line below, or, if it did keep it, this would build LLVM for the target and
# run the build environment out of disk.
#
# Buildroot 2026.05.1 has the panfrost driver `depends on
# BR2_PACKAGE_MESA3D_LLVM` and force-selecting NEEDS_PRECOMP_COMPILER, which
# pulls in MESA3D_OPENCL, SPIRV_LLVM_TRANSLATOR and SPIRV_TOOLS. That chain
# asks for LLVM and clang cross-compiled for the device -- about 28.5 GB of
# build tree. Mesa does not need any of it at runtime; it needs a compiler to
# precompile shaders at build time, and mesa3d.mk already builds one for the
# host and points the target build at it with -Dmesa-clc=system
# -Dprecomp-compiler=system. The patch drops the redundant target half.
#
# Built and shipping: mesa3d 26.1.2 with libEGL.so, libGLESv2.so, libgbm.so,
# and panfrost compiled into libgallium-26.1.2.so.
#
# OPENGL_EGL selects GBM on its own; it is listed anyway because kmscube
# depends on the GBM feature symbols directly and a silent deselect here would
# be hard to spot.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_KMSCUBE=y

# kmscube is the smallest honest test that the whole stack works: it opens the
# DRM device, creates a GBM surface, brings up EGL, and spins a GLES2 cube on
# the panel. "libEGL.so exists" does not distinguish a working driver from a
# stub, and this does.

# udev, so that third-party Linux userland can find the gamepad.
#
# Nerves does not normally want this: device nodes come from devtmpfs and
# nerves_uevent handles uevents in Elixir, so nothing in a stock Nerves system
# needs a udev daemon. This is here for programs that are not Elixir.
#
# RetroArch is the case that forced it. Built without udev it renders
# perfectly on this board -- Mali-G31 via Panfrost, GLES 3.1, shaders linked,
# framebuffer allocated at 640x480 -- and then exits:
#
#     [Video] Graphics driver did not initialize an input driver.
#     [ERROR] [Video] Cannot initialize input driver. Exiting...
#
# On Linux, udev *is* RetroArch's evdev path. Its only other input drivers are
# linuxraw, which reads console keycodes and so cannot see gamepad BTN_*
# events at all, and sdl, which needs SDL. There is no plain evdev driver, and
# no /dev/input/js* here either: the kernel has evdev, kbd, sysrq, leds and
# rfkill handlers and no joydev, so the legacy joystick API is not an option.
#
# Shipping libudev alone would not have been enough. input/drivers/udev_input.c
# selects devices with udev_enumerate_add_match_property(..., "ID_INPUT_KEY",
# "1"), and those properties are set by udev *rules*, which means udevd has to
# have run. So this is the daemon and its rules, not just the library.
#
# DYNAMIC_EUDEV keeps devtmpfs and adds eudev on top; it selects
# BR2_PACKAGE_EUDEV. Buildroot's init script for it does not run here, since
# erlinit is PID 1 -- the application starts udevd and replays the input
# uevents when it needs them, which keeps this out of the boot path that the
# panel depends on.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y

# The 87xx option is not a typo, and it is what makes Bluetooth work.
#
# This board's RTL8821CS needs two blobs. rtl8821cs_fw.bin arrives via the
# 88xx option above, whose file list is the glob rtl_bt/rtl88*.bin. The
# config blob does not, and the driver treats it as mandatory:
#
#     Bluetooth: hci0: RTL: loading rtl_bt/rtl8821cs_config.bin
#     bluetooth hci0: Direct firmware load for rtl_bt/rtl8821cs_config.bin
#                     failed with error -2
#     Bluetooth: hci0: RTL: mandatory config file rtl_bt/rtl8821cs_config
#                     not found
#
# Setup then aborts. hci0 still appears under /sys/class/bluetooth, so the
# usual "is there an hci0" check passes while Bluetooth is entirely dead --
# the same shape of silent failure as the green screen and the -110 GPU.
#
# The cause is upstream packaging, not this board. linux-firmware ships no
# rtl8821cs_config.bin file; WHENCE declares it as a symlink:
#
#     Link: rtl_bt/rtl8821cs_config.bin -> rtl8761b_config.bin
#
# Buildroot recreates WHENCE symlinks only when the target was packaged, and
# rtl8761b_config.bin does not match rtl88*.bin, so the link is skipped
# without a word. The 87xx option lists that file explicitly.
#
# The mechanism is confirmed on the device rather than assumed: rtl8723d_
# config.bin and rtl8821a_config.bin are both present there and both exist
# only as WHENCE symlinks -- they survive because they point at
# rtl8821c_config.bin, which the 88xx glob does match.
#
# This ships four 87xx firmware files that are dead weight on this board.
# That is the cost of getting one symlink target, and it is small.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_LATEST_VERSION=y
BR2_TARGET_UBOOT_USE_CUSTOM_CONFIG=y
BR2_TARGET_UBOOT_CUSTOM_CONFIG_FILE="${NERVES_DEFCONFIG_DIR}/uboot/uboot.defconfig"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-sunxi-with-spl.bin"
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
# NOTE: Buildroot depends on this path but not on the file's contents, so
# editing uboot/uboot.env does NOT regenerate images/uboot-env.bin on an
# incremental build -- it silently keeps the old environment. After changing
# it, force the regeneration:
#
#     make host-uboot-tools-rebuild && make
#
# and confirm with `strings images/uboot-env.bin | grep nerves_fw_`. Note too
# that the environment reaches a device only via fwup's `complete` task, so
# installing a changed one takes a `mix burn`, not a `mix upload`.
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="${NERVES_DEFCONFIG_DIR}/uboot/uboot.env"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="131072"
BR2_NERVES_SYSTEM_NAME="nerves_system_rg40xxv"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y
